#include <stdio.h>
#include <omp.h>

int main(void)
{
    int n;

    printf("Enter number of iterations: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Please enter a positive number.\n");
        return 1;
    }

    int thread_start[100];
    int thread_end[100];

    for (int i = 0; i < 100; i++) {
        thread_start[i] = -1;
        thread_end[i] = -1;
    }

    #pragma omp parallel for schedule(static, 2)
    for (int i = 0; i < n; i++) {
        int tid = omp_get_thread_num();

        if (thread_start[tid] == -1) {
            thread_start[tid] = i;
        }

        thread_end[tid] = i;
    }

    printf("\nThread distribution:\n");

    for (int i = 0; i < 100; i++) {
        if (thread_start[i] != -1) {
            printf("Thread %d : Iterations %d -- %d\n",
                   i, thread_start[i], thread_end[i]);
        }
    }

    return 0;
}
